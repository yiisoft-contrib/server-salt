#!/bin/sh
set -eu

usage() {
    printf 'Usage: %s <bookworm|trixie> <plan|minimal|full>\n' "$0" >&2
    exit 2
}

[ "$#" -eq 2 ] || usage
target=$1
phase=$2
case "$target" in
    bookworm) previous=bullseye ;;
    trixie) previous=bookworm ;;
    *) usage ;;
esac
case "$phase" in
    plan|minimal|full) ;;
    *) usage ;;
esac

if [ "$(id -u)" -ne 0 ]; then
    printf 'Run as root.\n' >&2
    exit 1
fi

. /etc/os-release
if [ "${ID:-}" != debian ] ||
   { [ "${VERSION_CODENAME:-}" != "$previous" ] && [ "${VERSION_CODENAME:-}" != "$target" ]; }; then
    printf 'The %s hop requires Debian %s, or %s to resume an interrupted hop.\n' "$target" "$previous" "$target" >&2
    exit 1
fi

if [ "$phase" != plan ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
    printf 'Run package upgrades interactively from the recovery console or its persistent terminal session.\n' >&2
    exit 1
fi

export LC_ALL=C
audit=$(dpkg --audit)
if [ -n "$audit" ]; then
    printf '%s\nResolve the dpkg audit findings before continuing.\n' "$audit" >&2
    exit 1
fi

apt-get -o APT::Update::Error-Mode=any update
indexes=$(apt-get indextargets --format '$(ORIGIN)|$(CODENAME)' 'Created-By: Packages')
if ! printf '%s\n' "$indexes" | awk -F '|' -v target="$target" '
    $1 == "Debian" && $2 == target { base = 1; next }
    $1 == "Debian" && ($2 == target "-updates" || $2 == target "-security") { next }
    { print "Unexpected APT package index: " $0 > "/dev/stderr"; invalid = 1 }
    END { exit (!base || invalid) }
'; then
    printf 'Enable the Debian %s package sources and disable other suites and third-party sources for this hop.\n' "$target" >&2
    exit 1
fi

case "$phase" in
    plan)
        printf '\nHeld packages\n'
        apt-mark showhold
        printf '\nFree disk space\n'
        df -h / /boot /var
        printf '\nFull-upgrade simulation\n'
        exec apt-get --simulate dist-upgrade
        ;;
    minimal) exec apt-get upgrade ;;
    full) exec apt-get dist-upgrade ;;
esac
